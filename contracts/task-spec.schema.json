{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.invalid/contracts/task-spec.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1
        },
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0
        }
      },
      "required": [
        "allowedPaths",
        "forbiddenPaths",
        "outOfScope"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "verification": {
            "type": "string",
            "enum": [
              "check",
              "review",
              "human"
            ]
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "requirement",
          "verification",
          "checkIds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "contextFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 200
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{32}$"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high"
      ]
    },
    "implementerProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "reviewerProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 1,
      "maxItems": 5
    },
    "checkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 1,
      "maxItems": 100
    },
    "interaction": {
      "type": "string",
      "enum": [
        "managed",
        "native"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxRepairCycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "wallTimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "outputTokenLimit": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000
        },
        "costLimitMicros": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "maxAttempts",
        "maxRepairCycles",
        "wallTimeSeconds",
        "outputTokenLimit",
        "costLimitMicros"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "objective",
    "scope",
    "requirements",
    "contextFiles",
    "dependsOn",
    "risk",
    "implementerProfile",
    "reviewerProfiles",
    "checkIds",
    "interaction",
    "budget"
  ],
  "additionalProperties": false
}
