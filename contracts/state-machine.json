      "to": "changes_required"
    },
    {
      "from": "awaiting_approval",
      "event": "INTEGRATION_AUTHORIZED",
      "to": "integrating"
    },
    {
      "from": "integrating",
      "event": "INTEGRATION_CONFIRMED",
      "to": "integrated"
    },
    {
      "from": "awaiting_approval",
      "event": "CANDIDATE_INVALIDATED",
      "to": "changes_required"
    },
    {
      "from": "integrating",
      "event": "BASE_MOVED",
      "to": "changes_required"
    },
    {
      "from": "changes_required",
      "event": "REVISION_REQUESTED",
      "to": "ready"
    },
    {
      "from": "failed",
