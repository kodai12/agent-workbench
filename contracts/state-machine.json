{
  "schemaVersion": 1,
  "taskStates": [
    "draft",
    "ready",
    "allocating",
    "running",
    "waiting_human",
    "freezing",
    "verifying",
    "reviewing",
    "changes_required",
    "awaiting_approval",
    "integrating",
    "integrated",
    "cancelled",
    "failed",
    "recovery_required"
  ],
  "runStates": [
    "created",
    "starting",
    "running",
    "waiting_input",
    "stopping",
    "completed",
    "failed",
    "cancelled",
    "unknown"
  ],
  "terminalTaskStates": [
    "integrated",
    "cancelled"
  ],
  "transitions": [
    {
      "from": "draft",
      "event": "TASK_SUBMITTED",
      "to": "ready"
    },
    {
      "from": "ready",
      "event": "START_REQUESTED",
      "to": "allocating"
    },
    {
      "from": "allocating",
      "event": "WORKER_READY",
      "to": "running"
    },
    {
      "from": "running",
      "event": "INPUT_REQUIRED",
      "to": "waiting_human"
    },
    {
      "from": "waiting_human",
      "event": "HUMAN_REPLY",
      "to": "running"
    },
    {
      "from": "running",
      "event": "IMPLEMENTATION_RETURNED",
      "to": "freezing"
    },
    {
      "from": "running",
      "event": "NATIVE_FINISH_REQUESTED",
      "to": "freezing"
    },
    {
      "from": "freezing",
      "event": "CANDIDATE_FROZEN",
      "to": "verifying"
    },
    {
      "from": "verifying",
      "event": "CHECKS_PASSED",
      "to": "reviewing"
    },
    {
      "from": "verifying",
      "event": "CHECKS_FAILED",
      "to": "changes_required"
    },
    {
      "from": "reviewing",
